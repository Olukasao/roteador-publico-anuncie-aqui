# URL do backend (apps/api). Use o IP da VM na rede local (não "localhost") se for
# testar pelo celular — "localhost" no navegador do celular aponta pro próprio celular.
VITE_API_URL=http://192.168.1.133:4000

# Producao: URL HTTPS da API central. Todos os roteadores usam o mesmo backend;
# nenhum cadastro deve ficar armazenado somente no equipamento/local.
# VITE_API_URL=https://wifi.acessanet.com.br
