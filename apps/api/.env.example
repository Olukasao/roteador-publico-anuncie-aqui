PORT=4000
DATABASE_URL="file:./dev.db"

# Token fixo de serviço para a rota interna GET /internal/marketing-leads.
# Gerar com: openssl rand -hex 32
# O MESMO valor precisa estar em Site-Acessanet/server/.env como ACESSANET_CONNECT_TOKEN.
CONNECT_INTERNAL_TOKEN=

# Origens autorizadas a chamar os endpoints públicos (separadas por vírgula).
# Inclua o IP da VM na rede local se o portal for acessado pelo celular.
CORS_ORIGINS=http://localhost:5190,http://192.168.1.133:5190
